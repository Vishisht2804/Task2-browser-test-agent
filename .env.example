# Application settings (all variables use the BA_ prefix)
BA_ENVIRONMENT=development
BA_LOG_LEVEL=INFO
BA_DEFAULT_MAX_STEPS=25
BA_DEFAULT_TIMEOUT_SECONDS=120
BA_BROWSER_HEADLESS=true
BA_BROWSER_ACTION_TIMEOUT_MS=10000
BA_BROWSER_NAVIGATION_TIMEOUT_MS=30000
# Optional: path to a locally installed Chromium executable. Usually leave blank.
# BA_BROWSER_EXECUTABLE_PATH=C:/path/to/chrome.exe
BA_ARTIFACT_DIR=artifacts

# LLM provider configuration. The actual adapter is added in Phase 3.
BA_LLM_PROVIDER=openai
BA_LLM_MODEL=
BA_LLM_API_KEY=
BA_LLM_BASE_URL=

# Example test data references. Add actual values only to your untracked .env file.
# CUSTOMER_EMAIL=customer@example.com
# CUSTOMER_PASSWORD=replace-me
